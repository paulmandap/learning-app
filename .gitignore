# Secrets — never commit. .env holds the Supabase publishable key locally.
.env
.env.local
.env.*.local
!.env.example

# Dependencies
node_modules/

# Expo / build output
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects (generated by prebuild)
/ios
/android

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Design references — generated mock-ups and the Nomi character sheet.
#
# Reference material for building the UI, NOT app assets: nothing under here is
# imported or shipped. `scripts/make-nomi-assets.ts` reads the character sheet
# from here to cut the owl's parts, and what it writes to assets/ is what ships.
design-reference/

# Logs / OS cruft
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Database dumps. Real user notes — never committed.
#
# `backups/` alone was not enough. A restore drill on 2026-09-12 downloaded the
# backup artifact and unzipped it into the repository ROOT, where both the .zip
# and backup.tar.gz.gpg sat untracked and unignored — one `git add -A` away
# from publishing every student's notes to a public repository. Encrypted, but
# an encrypted file in a public repo is a passphrase away from not being.
#
# So the patterns match wherever the file lands, not only in one folder.
backups/
*.gpg
backup.tar.gz*
schema.sql
data.sql
supabase-backup-*
