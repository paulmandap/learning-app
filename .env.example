# Copy to .env and fill in. .env is gitignored; this file holds NAMES ONLY.
# Never put a real credential in this file.

# --- Supabase (client) ---
# The publishable key is safe to ship in client code: it reaches only what RLS allows.
# NEVER use a secret / service-role key here or anywhere in the app — those bypass RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Gemini ---
# Deliberately absent. The user's Gemini key is NOT an environment variable.
# It is entered in Settings and stored per-user in profiles.gemini_api_key under RLS (D12).

# --- Tests ---
# Live Gemini tests are skipped unless this is set to 1. Never required for CI.
# LIVE_GEMINI=1
